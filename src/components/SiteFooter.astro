---
import { business, navLinks } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div>
        <div class="brand">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--brand-green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 17 3.5s1.5 2 2.1 5.5A7 7 0 0 1 11 20Z"></path>
            <path d="M11 20v-8"></path>
            <path d="M8 17c1-1 3-1.5 5-1"></path>
          </svg>
          <span>{business.name}</span>
        </div>
        <p class="blurb">
          Your trusted local cleaning service in Madeley and the surrounding area.
        </p>
      </div>

      <div>
        <h3>On this page</h3>
        <div class="links">
          {navLinks.map((link) => <a href={link.href}>{link.footerLabel}</a>)}
        </div>
      </div>

      <div>
        <h3>Contact Us</h3>
        <div class="contact">
          <div class="line">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="var(--brand-green-500)" aria-hidden="true">
              <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"></path>
            </svg>
            <span>{business.address.full}</span>
          </div>
          <a href={business.phoneLink} class="line">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="var(--brand-green-500)" aria-hidden="true">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
            </svg>
            {business.phone}
          </a>
          <a href={`mailto:${business.email}`} class="line">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="var(--brand-green-500)" aria-hidden="true">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            {business.email}
          </a>
          <div class="line">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="var(--brand-green-500)" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"></path>
            </svg>
            {business.hours}
          </div>
        </div>
      </div>
    </div>

    <div class="bottom">
      <p>© {year} {business.name}. All rights reserved.</p>
      <a href="/#top">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-footer);
    color: var(--gray-700);
  }

  .site-footer :global(.container) {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .brand span {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .blurb {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  h3 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-subtle);
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .links a {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--duration-base) var(--ease-default);
  }

  .links a:hover {
    color: var(--brand-green-600);
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .line {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--text-muted);
    transition: color var(--duration-base) var(--ease-default);
  }

  .line svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  a.line:hover {
    color: var(--brand-green-600);
  }

  .bottom {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-strong);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .bottom p {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .bottom a {
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .bottom a:hover {
    color: var(--brand-green-600);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
