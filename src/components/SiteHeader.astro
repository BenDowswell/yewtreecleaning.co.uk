---
import { business, navLinks } from '../data/site';
---

<header class="site-header">
  <div class="inner">
    <a href="/#top" class="brand">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="var(--brand-green-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 17 3.5s1.5 2 2.1 5.5A7 7 0 0 1 11 20Z"></path>
        <path d="M11 20v-8"></path>
        <path d="M8 17c1-1 3-1.5 5-1"></path>
      </svg>
      <span class="brand-name">{business.name}</span>
    </a>

    <nav class="nav" aria-label="Sections">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a href={business.phoneLink} class="call">
      <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
      </svg>
      {business.phone}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-3) var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
  }

  .brand-name {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--text-heading);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav a {
    border-radius: var(--radius-lg);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--gray-600);
    transition: background var(--duration-base) var(--ease-default),
      color var(--duration-base) var(--ease-default);
  }

  .nav a:hover {
    background: var(--brand-green-50);
    color: var(--brand-green-700);
  }

  .call {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: var(--radius-control);
    background: var(--action-primary);
    color: var(--text-on-brand);
    padding: var(--space-2-5) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition: background var(--duration-base) var(--ease-default);
  }

  .call:hover {
    background: var(--action-primary-hover);
    color: var(--text-on-brand);
  }

  /* The design is drawn at 1280px only. Below 900px the anchor nav would crowd
     the phone button, so it drops out — every link is still in the footer. */
  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .inner {
      padding: var(--space-3) var(--space-5);
    }
  }

  /* At phone widths the brand name and the phone number compete for the same
     row. Keep both on one line by tightening rather than letting either wrap. */
  @media (max-width: 430px) {
    .brand-name {
      font-size: 0.9375rem;
      white-space: nowrap;
    }

    .brand svg {
      width: 22px;
      height: 22px;
    }

    .brand {
      gap: var(--space-1-5);
    }

    .inner {
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }

    .call {
      font-size: 0.8125rem;
      padding: var(--space-2) var(--space-3);
      gap: var(--space-1-5);
    }
  }
</style>
