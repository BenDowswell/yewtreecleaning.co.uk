---
import 'leaflet/dist/leaflet.css';
import { business, areasSentence } from '../data/site';

const { latitude, longitude, radiusMetres } = business.geo;
---

<section id="areas" class="areas">
  <div class="container narrow">
    <div class="intro">
      <h2 class="section-heading">Areas We Cover</h2>
      <p>
        Based in Madeley, we clean homes within approximately 10 miles of the
        surrounding area.
      </p>
    </div>

    <div class="panel">
      <div
        id="areas-map"
        class="map"
        role="img"
        aria-label="Map of the service area: Madeley and approximately 10 miles around it"
        data-lat={latitude}
        data-lng={longitude}
        data-radius={radiusMetres}
      >
        <p class="map-fallback">
          We cover Madeley and everywhere within roughly 10 miles of it.
        </p>
      </div>
      <p class="towns">{areasSentence}</p>
    </div>

    <div class="callout">
      Not sure if we cover your area? Give us a call on{' '}
      <a href={business.phoneLink}>{business.phone}</a> — we’re always happy to check.
    </div>
  </div>
</section>

<script>
  const el = document.getElementById('areas-map');

  if (el) {
    let started = false;

    const start = async () => {
      if (started) return;
      started = true;

      const L = (await import('leaflet')).default;

      const lat = Number(el.dataset.lat);
      const lng = Number(el.dataset.lng);
      const radius = Number(el.dataset.radius);

      el.textContent = '';
      el.setAttribute('role', 'region');

      const map = L.map(el, {
        center: [lat, lng],
        zoom: 10,
        zoomSnap: 0.25,
        scrollWheelZoom: false,
        attributionControl: true,
      });

      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);

      const area = L.circle([lat, lng], {
        radius,
        color: '#4a8a62',
        weight: 2,
        dashArray: '6 6',
        fillColor: '#5fa078',
        fillOpacity: 0.15,
      }).addTo(map);

      L.marker([lat, lng], {
        title: 'Madeley',
        icon: L.divIcon({
          className: 'areas-pin',
          html:
            '<svg viewBox="0 0 24 24" width="32" height="32" fill="#5fa078" aria-hidden="true">' +
            '<path d="M12 2a7 7 0 00-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 00-7-7zm0 9.5A2.5 2.5 0 1112 6.5a2.5 2.5 0 010 5z"/>' +
            '</svg><span>Madeley</span>',
          iconSize: [32, 46],
          iconAnchor: [16, 40],
        }),
      }).addTo(map);

      map.fitBounds(area.getBounds(), { padding: [4, 4] });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            start();
          }
        },
        { rootMargin: '200px' }
      );
      observer.observe(el);
    } else {
      start();
    }
  }
</script>

<style>
  .areas {
    background: var(--surface-tint);
  }

  .narrow {
    max-width: 64rem;
  }

  .intro {
    text-align: center;
  }

  .intro p {
    margin: var(--space-4) auto 0;
    max-width: 42rem;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }

  .panel {
    margin: var(--space-10) auto 0;
    max-width: 44rem;
    border-radius: var(--radius-panel);
    border: 1px solid var(--border-default);
    background: var(--surface-card);
    padding: var(--space-6);
  }

  .map {
    position: relative;
    z-index: 0;
    height: 360px;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-tint);
    background: var(--brand-green-50);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-fallback {
    margin: 0;
    padding: 0 var(--space-6);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .towns {
    margin: var(--space-5) 0 0;
    text-align: center;
    font-size: 0.9375rem;
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }

  .callout {
    margin-top: var(--space-8);
    border-radius: var(--radius-card);
    border: 1px solid var(--border-tint);
    background: var(--surface-card);
    padding: var(--space-5) var(--space-6);
    text-align: center;
    color: var(--brand-green-800);
  }

  .callout a {
    font-weight: var(--weight-semibold);
    color: var(--brand-green-700);
  }

  @media (max-width: 640px) {
    .panel {
      padding: var(--space-4);
    }

    .map {
      height: 280px;
    }
  }
</style>

<style is:global>
  .areas-pin {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .areas-pin span {
    margin-top: 2px;
    white-space: nowrap;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-green-800);
    text-shadow: 0 1px 2px var(--white), 0 -1px 2px var(--white),
      1px 0 2px var(--white), -1px 0 2px var(--white);
  }

  .leaflet-container {
    height: 100%;
    width: 100%;
    background: var(--brand-green-50);
    font: inherit;
  }
</style>
