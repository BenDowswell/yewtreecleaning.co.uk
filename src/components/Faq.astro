---
import { faq } from '../data/site';

// Chevron path from the design system's Icon set ('chevron-down', solid 20).
const CHEVRON =
  'M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z';
---

<section id="faq">
  <div class="container prose">
    <h2 class="section-heading centred">Frequently Asked Questions</h2>

    <div class="accordion">
      {
        faq.map((item, i) => (
          /* A shared `name` makes these mutually exclusive natively, matching
             the design system's single-open Accordion. The design passes
             defaultOpen={0}, so the first item starts open. */
          <details name="faq" open={i === 0}>
            <summary>
              <span class="question">{item.question}</span>
              <svg class="chevron" viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d={CHEVRON} />
              </svg>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .prose {
    max-width: var(--container-prose);
  }

  .centred {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .accordion {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  details + details {
    border-top: 1px solid var(--border-subtle);
  }

  summary {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    text-align: left;
    cursor: pointer;
    background: transparent;
    transition: background var(--duration-base) var(--ease-default);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    content: '';
  }

  summary:hover {
    background: var(--gray-50);
  }

  .question {
    font-weight: var(--weight-medium);
    color: var(--text-heading);
    font-size: var(--text-base);
  }

  .chevron {
    flex-shrink: 0;
    color: var(--text-subtle);
    transition: transform var(--duration-base) var(--ease-default);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  details p {
    margin: 0;
    padding: 0 var(--space-6) var(--space-4);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    font-size: var(--text-base);
  }

  /* The design system's React Accordion animates max-height 0 -> 384px over
     200ms. <details> cannot animate its own height without these two features,
     so browsers that have them get the transition and the rest open instantly.
     The chevron rotation animates everywhere. */
  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }

    details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size var(--duration-base) var(--ease-default),
        content-visibility var(--duration-base) var(--ease-default) allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
    }
  }

  @media (max-width: 640px) {
    summary {
      padding: var(--space-4) var(--space-5);
    }

    details p {
      padding: 0 var(--space-5) var(--space-4);
    }
  }
</style>
