---
import { business } from '../data/site';
---

<section id="contact" class="contact">
  <div class="container">
    <div class="inner">
      <h2>Ready for a Cleaner Home?</h2>
      <p class="lede">
        Call, email or send a WhatsApp message and we’ll get back to you within
        24 hours. Bookings need at least 24 hours’ notice, and nothing is paid
        until the clean is done.
      </p>

      <div class="actions">
        <a href={business.phoneLink} class="btn-solid">
          <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
          </svg>
          Call {business.phone}
        </a>
        <a href={`mailto:${business.email}`} class="btn-ghost">
          <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
          </svg>
          Email us
        </a>
      </div>

      <p class="footnote">{business.hours} · {business.address.full}</p>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--surface-inverse);
  }

  .inner {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  h2 {
    margin: 0;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--white);
  }

  .lede {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.9);
  }

  .actions {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-solid,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: var(--radius-control);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    transition: background var(--duration-base) var(--ease-default);
  }

  .btn-solid {
    background: var(--white);
    color: var(--brand-green-700);
    padding: var(--space-3-5) var(--space-8);
  }

  .btn-solid:hover {
    background: var(--gray-50);
    color: var(--brand-green-700);
  }

  .btn-ghost {
    border: 2px solid var(--white);
    color: var(--white);
    padding: var(--space-3) 30px;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
  }

  .footnote {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 640px) {
    h2 {
      font-size: var(--text-3xl);
      line-height: var(--text-3xl-lh);
    }

    .lede {
      font-size: var(--text-base);
    }

    .btn-solid,
    .btn-ghost {
      justify-content: center;
      flex: 1 1 100%;
    }
  }
</style>
