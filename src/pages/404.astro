---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { business } from '../data/site';
---

<BaseLayout
  title="Page not found | Yew Tree Cleaning"
  description="Sorry, that page does not exist. Head back to the Yew Tree Cleaning homepage or give us a call."
>
  <SiteHeader />
  <main>
    <section id="top" class="notfound">
      <div class="container">
        <p class="code">404</p>
        <h1>We couldn’t find that page</h1>
        <p class="body">
          The page you were looking for has moved or never existed. Everything
          about our cleaning services is on the homepage.
        </p>
        <div class="actions">
          <a href="/" class="btn-primary">Back to the homepage</a>
          <a href={business.phoneLink} class="btn-outline">Call {business.phone}</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .notfound {
    background: linear-gradient(to bottom, var(--brand-green-50), var(--white));
  }

  .notfound :global(.container) {
    text-align: center;
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .code {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--brand-green-600);
  }

  h1 {
    margin: var(--space-3) 0 0;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-heading);
  }

  .body {
    margin: var(--space-4) auto 0;
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }

  .actions {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-control);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    transition: background var(--duration-base) var(--ease-default);
  }

  .btn-primary {
    background: var(--action-primary);
    color: var(--text-on-brand);
    padding: var(--space-3-5) var(--space-8);
  }

  .btn-primary:hover {
    background: var(--action-primary-hover);
    color: var(--text-on-brand);
  }

  .btn-outline {
    border: 2px solid var(--border-brand);
    color: var(--brand-green-700);
    padding: var(--space-3) 30px;
  }

  .btn-outline:hover {
    background: var(--brand-green-50);
    color: var(--brand-green-700);
  }
</style>
