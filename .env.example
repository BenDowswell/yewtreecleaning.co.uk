# Yew Tree Cleaning - Environment Variables
# Copy this file to .env.local and fill in values

# Site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (Resend)
# Contact, quote, and booking submissions are emailed using these settings.
# Without RESEND_API_KEY the forms return an error telling the customer to
# phone instead, so this must be set in production.
RESEND_API_KEY=

# Must be on a domain verified in Resend. Defaults to the address below.
EMAIL_FROM="Yew Tree Cleaning <bookings@yewtreecleaning.co.uk>"

# Where enquiries are delivered. Defaults to joy.dowswell@gmail.com.
EMAIL_TO=joy.dowswell@gmail.com

# Future: Database connection
# DATABASE_URL=

# Future: Auth secret
# NEXTAUTH_SECRET=
